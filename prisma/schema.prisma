generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ISSUER
  HOLDER
}

enum NamePrefix {
  MR
  MISS
  MRS
}

enum IssuerAccountType {
  UNIVERSITY_ADMIN
  REGISTRAR_STAFF
}

enum CredentialStatus {
  PENDING
  VERIFIED
  INVALID
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          UserRole
  name          String
  walletAddress String?
  namePrefix   NamePrefix?

  firstNameTh       String?
  lastNameTh        String?
  firstNameEn       String?
  lastNameEn        String?
  phone             String?
  birthDate         DateTime?
  studentId         String?
  faculty           String?
  major             String?
  universityNameTh  String?
  universityNameEn  String?
  contactFirstNameTh String?
  contactLastNameTh  String?
  contactFirstNameEn String?
  contactLastNameEn  String?
  staffPosition      String?
  staffDepartment    String?
  website           String?
  address           String?
  addressDetail     String?
  province          String?
  district          String?
  subDistrict       String?
  postalCode        String?
  nationalIdHash    String?

  universityId      String?
  university        University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  ownedUniversity   University? @relation("UniversityOwner")

  issuerAccountType IssuerAccountType?
  universityOwnerId String?
  universityOwner   User?  @relation("UniversityStaff", fields: [universityOwnerId], references: [id], onDelete: SetNull)
  staffMembers      User[] @relation("UniversityStaff")
  permissions       String[] @default([])
  isActive          Boolean @default(true)
  emailVerifiedAt    DateTime?
  emailVerificationTokenHash String? @unique
  emailVerificationExpiresAt DateTime?

  issuedCredentials Credential[] @relation("IssuerCredentials")
  ownedCredentials  Credential[] @relation("HolderCredentials")
  staffIssuedCredentials Credential[] @relation("CredentialIssuerStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shareLinks CredentialShareLink[] @relation("HolderShareLinks")

  @@index([universityOwnerId])
  @@index([role, issuerAccountType])
  @@index([universityId])
  @@index([studentId, universityId])
}

model UniversityMaster {
  id        String   @id @default(uuid())
  nameTh    String   @unique
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  universities University[]
}

model University {
  id                 String           @id @default(uuid())
  masterId           String
  ownerUserId        String           @unique
  phone              String?
  website            String?
  addressDetail      String?
  province           String?
  district           String?
  subDistrict        String?
  postalCode         String?
  status             UniversityStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  master             UniversityMaster @relation(fields: [masterId], references: [id], onDelete: Restrict)
  owner              User             @relation("UniversityOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  users              User[]
  faculties          Faculty[]

  @@index([masterId])
  @@index([status])
}

model Faculty {
  id           String   @id @default(uuid())
  universityId String
  nameTh       String
  nameEn       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  majors     Major[]

  @@unique([universityId, nameTh])
  @@index([universityId, isActive])
}

model Major {
  id        String   @id @default(uuid())
  facultyId String
  nameTh    String
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([facultyId, nameTh])
  @@index([facultyId, isActive])
}

model Credential {
  id           String @id @default(uuid())
  credentialId String @unique @default(uuid())

  issuerId String
  holderId String
  issuerStaffId String?

  issuer User @relation("IssuerCredentials", fields: [issuerId], references: [id])
  holder User @relation("HolderCredentials", fields: [holderId], references: [id])
  issuerStaff User? @relation("CredentialIssuerStaff", fields: [issuerStaffId], references: [id], onDelete: SetNull)

  issuedByName String?
  issuedByEmail String?
  issuedByPosition String?
  issuedByDepartment String?

  studentName String
  studentId   String
  faculty     String?
  major       String?

  documentTitle String
  issuedAt      DateTime

  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String

  documentHash String

  status CredentialStatus @default(PENDING)

  network         String?
  transactionHash String?
  blockNumber     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shareLinks CredentialShareLink[]

  @@index([issuerId])
  @@index([issuerStaffId])
  @@index([holderId])
}

model CredentialShareLink {
  id    String @id @default(uuid())
  token String @unique

  credentialId String
  holderId     String

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  holder     User       @relation("HolderShareLinks", fields: [holderId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([credentialId])
  @@index([holderId])
  @@index([token])
}
