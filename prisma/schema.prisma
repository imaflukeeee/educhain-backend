generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ISSUER
  HOLDER
}

enum CredentialStatus {
  PENDING
  VERIFIED
  INVALID
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          UserRole
  name          String
  walletAddress String?

  issuedCredentials Credential[] @relation("IssuerCredentials")
  ownedCredentials  Credential[] @relation("HolderCredentials")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  shareLinks CredentialShareLink[] @relation("HolderShareLinks")
}

model Credential {
  id           String @id @default(uuid())
  credentialId String @unique @default(uuid())

  issuerId String
  holderId String

  issuer User @relation("IssuerCredentials", fields: [issuerId], references: [id])
  holder User @relation("HolderCredentials", fields: [holderId], references: [id])

  studentName String
  studentId   String
  faculty     String?
  major       String?

  documentTitle String
  issuedAt      DateTime

  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String

  documentHash String

  status CredentialStatus @default(PENDING)

  network         String?
  transactionHash String?
  blockNumber     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shareLinks CredentialShareLink[]
}

model CredentialShareLink {
  id    String @id @default(uuid())
  token String @unique

  credentialId String
  holderId     String

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  holder     User       @relation("HolderShareLinks", fields: [holderId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([credentialId])
  @@index([holderId])
  @@index([token])
}