generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}

enum UserRole {
  ISSUER
  HOLDER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          UserRole
  name          String
  walletAddress String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}