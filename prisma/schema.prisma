generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ISSUER
  HOLDER
}

enum NamePrefix {
  MR
  MISS
  MRS
}

enum IssuerAccountType {
  UNIVERSITY_ADMIN
  REGISTRAR_STAFF
}

enum CredentialStatus {
  PENDING
  VERIFIED
  INVALID
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
}

enum StudentClaimStatus {
  UNCLAIMED
  CLAIMED
  REVIEW_REQUIRED
  REJECTED
}

enum CredentialWorkflowStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  PENDING_APPROVAL
  REJECTED
  APPROVED
  ISSUED
}

enum NotificationType {
  STUDENT_CLAIMED
  CLAIM_REVIEW_REQUIRED
  CREDENTIAL_REVIEW
  CREDENTIAL_APPROVAL
  CREDENTIAL_CHANGES
  CREDENTIAL_ISSUED
  SYSTEM
}

enum AuditAction {
  STUDENT_CREATED
  STUDENT_IMPORTED
  STUDENT_CLAIMED
  CLAIM_REVIEWED
  WORKFLOW_SUBMITTED
  WORKFLOW_REVIEWED
  WORKFLOW_APPROVED
  WORKFLOW_REJECTED
  WORKFLOW_CHANGES_REQUESTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          UserRole
  name          String
  walletAddress String?
  namePrefix   NamePrefix?

  firstNameTh       String?
  lastNameTh        String?
  firstNameEn       String?
  lastNameEn        String?
  phone             String?
  birthDate         DateTime?
  studentId         String?
  faculty           String?
  major             String?
  universityNameTh  String?
  universityNameEn  String?
  contactFirstNameTh String?
  contactLastNameTh  String?
  contactFirstNameEn String?
  contactLastNameEn  String?
  staffPosition      String?
  staffDepartment    String?
  website           String?
  address           String?
  addressDetail     String?
  province          String?
  district          String?
  subDistrict       String?
  postalCode        String?
  nationalIdHash    String?

  universityId      String?
  university        University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  ownedUniversity   University? @relation("UniversityOwner")

  issuerAccountType IssuerAccountType?
  universityOwnerId String?
  universityOwner   User?  @relation("UniversityStaff", fields: [universityOwnerId], references: [id], onDelete: SetNull)
  staffMembers      User[] @relation("UniversityStaff")
  permissions       String[] @default([])
  isActive          Boolean @default(true)
  emailVerifiedAt    DateTime?
  emailVerificationTokenHash String? @unique
  emailVerificationExpiresAt DateTime?

  issuedCredentials Credential[] @relation("IssuerCredentials")
  ownedCredentials  Credential[] @relation("HolderCredentials")
  staffIssuedCredentials Credential[] @relation("CredentialIssuerStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shareLinks CredentialShareLink[] @relation("HolderShareLinks")
  claimedStudentRecord StudentRecord? @relation("ClaimedStudent")
  createdStudentRecords StudentRecord[] @relation("StudentRecordCreator")
  claimAttempts ClaimAttempt[]
  notifications Notification[]
  auditLogs AuditLog[] @relation("AuditActor")
  preparedCredentials Credential[] @relation("CredentialPreparer")
  reviewedCredentials Credential[] @relation("CredentialReviewer")
  approvedCredentials Credential[] @relation("CredentialApprover")

  @@index([universityOwnerId])
  @@index([role, issuerAccountType])
  @@index([universityId])
  @@index([studentId, universityId])
}

model UniversityMaster {
  id        String   @id @default(uuid())
  nameTh    String   @unique
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  universities University[]
}

model University {
  id                 String           @id @default(uuid())
  masterId           String
  ownerUserId        String           @unique
  phone              String?
  website            String?
  addressDetail      String?
  province           String?
  district           String?
  subDistrict        String?
  postalCode         String?
  status             UniversityStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  master             UniversityMaster @relation(fields: [masterId], references: [id], onDelete: Restrict)
  owner              User             @relation("UniversityOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  users              User[]
  faculties          Faculty[]
  studentRecords     StudentRecord[]
  claimAttempts      ClaimAttempt[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([masterId])
  @@index([status])
}

model Faculty {
  id           String   @id @default(uuid())
  universityId String
  nameTh       String
  nameEn       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  majors     Major[]
  studentRecords StudentRecord[]

  @@unique([universityId, nameTh])
  @@index([universityId, isActive])
}

model Major {
  id        String   @id @default(uuid())
  facultyId String
  nameTh    String
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  studentRecords StudentRecord[]

  @@unique([facultyId, nameTh])
  @@index([facultyId, isActive])
}

model Credential {
  id           String @id @default(uuid())
  credentialId String @unique @default(uuid())

  issuerId String
  holderId String
  issuerStaffId String?

  issuer User @relation("IssuerCredentials", fields: [issuerId], references: [id])
  holder User @relation("HolderCredentials", fields: [holderId], references: [id])
  issuerStaff User? @relation("CredentialIssuerStaff", fields: [issuerStaffId], references: [id], onDelete: SetNull)

  issuedByName String?
  issuedByEmail String?
  issuedByPosition String?
  issuedByDepartment String?

  studentName String
  studentId   String
  faculty     String?
  major       String?

  documentTitle String
  issuedAt      DateTime

  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String

  documentHash String

  status CredentialStatus @default(PENDING)
  workflowStatus CredentialWorkflowStatus @default(DRAFT)
  preparedById String?
  reviewedById String?
  approvedById String?
  workflowNote String?
  submittedAt DateTime?
  reviewedAt DateTime?
  approvedAt DateTime?
  preparedBy User? @relation("CredentialPreparer", fields: [preparedById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("CredentialReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("CredentialApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  network         String?
  transactionHash String?
  blockNumber     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shareLinks CredentialShareLink[]

  @@index([issuerId])
  @@index([issuerStaffId])
  @@index([holderId])
  @@index([workflowStatus])
  @@index([preparedById])
  @@index([reviewedById])
  @@index([approvedById])
}

model CredentialShareLink {
  id    String @id @default(uuid())
  token String @unique

  credentialId String
  holderId     String

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  holder     User       @relation("HolderShareLinks", fields: [holderId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([credentialId])
  @@index([holderId])
  @@index([token])
}


model StudentRecord {
  id             String             @id @default(uuid())
  universityId   String
  studentId      String
  namePrefix     NamePrefix?
  firstNameTh    String
  lastNameTh     String
  firstNameEn    String?
  lastNameEn     String?
  birthDate      DateTime
  nationalIdHash String?
  email          String?
  facultyId      String?
  majorId        String?
  claimStatus    StudentClaimStatus @default(UNCLAIMED)
  claimedById    String?            @unique
  claimedAt      DateTime?
  isActive       Boolean            @default(true)
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  major Major? @relation(fields: [majorId], references: [id], onDelete: SetNull)
  claimedBy User? @relation("ClaimedStudent", fields: [claimedById], references: [id], onDelete: SetNull)
  createdBy User? @relation("StudentRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  claimAttempts ClaimAttempt[]

  @@unique([universityId, studentId])
  @@index([universityId, claimStatus])
  @@index([facultyId])
  @@index([majorId])
}

model ClaimAttempt {
  id              String   @id @default(uuid())
  universityId    String
  studentRecordId String?
  userId          String
  studentId       String
  matched         Boolean
  reason          String?
  createdAt       DateTime @default(now())

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  studentRecord StudentRecord? @relation(fields: [studentRecordId], references: [id], onDelete: SetNull)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([universityId, createdAt])
  @@index([userId])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  universityId String?
  type         NotificationType
  title        String
  message      String
  link         String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([universityId])
}

model AuditLog {
  id           String      @id @default(uuid())
  actorId      String?
  universityId String?
  action       AuditAction
  entityType   String
  entityId     String?
  beforeData   Json?
  afterData    Json?
  createdAt    DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  university University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId, createdAt])
  @@index([actorId])
}
