# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"
APP_BASE_URL="http://localhost:4000"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT
JWT_SECRET="replace-with-your-jwt-secret"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="credentials"

# Blockchain
BLOCKCHAIN_NETWORK="Polygon Amoy"
AMOY_RPC_URL="https://rpc-amoy.polygon.technology/"
CONTRACT_ADDRESS="0xYourContractAddress"
BLOCKCHAIN_PRIVATE_KEY="replace-with-your-wallet-private-key"